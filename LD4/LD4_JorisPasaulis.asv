%Joris Pasaulis Ef-24 2026-09-30
%a
clear
close all
[X, Y]=meshgrid(-1:0.1:1);
r=sqrt(X.^2+Y.^2);
Z=exp(r.^2);
surf(X,Y,Z);
colormap gray
shading interp
view(30,30);
hold on;
title('Z=exp(r^2),r=sqrt(x^2+y^2)');
xlabel('x');
ylabel('y');
zlabel('z');
%%
%b
clear
close all
[X, Y]=meshgrid(-2:0.5:1);

f=1-2*X.^2-3*Y.^2;
surf(X,Y,f);
colormap autumn
shading faceted
view(45,45);
hold on;
title('f=1-2*X^2-3*Y^2');
xlabel('x');
ylabel('y');
zlabel('z');

%%
%papildoma
clear 
close all
[X, Y]=meshgrid(-2:0.5:1);
z=1-(X.^2+Y.^2);

figure
surf(X,Y,z)

camlight('right')

xlabel('x')
ylabel('y')
zlabel('z')
title('apšviesta')

figure
contour(X,Y,z,20)
colorbar
xlabel('x')
ylabel('y')
title('Kontūrinis grafikas')
axis equal

